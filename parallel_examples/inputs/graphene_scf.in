&CONTROL
  calculation = 'scf',
  prefix = 'graphene',
  outdir = '/xdisk/ngolubev/mingruiyuan/QE_diffr/tmp/',
  pseudo_dir = '/xdisk/ngolubev/mingruiyuan/pseudo/',
  ! tstress = .true.,
  ! tprnfor = .true.,
  verbosity='high',
  !wf_collect = .true.,  ! Collect wavefunctions
  !disk_io = 'high'  ! Manage I/O to avoid excessive memory usage
/


&SYSTEM
  ibrav     = 0,  ! old is 4
  nat  = 2,
  ntyp = 1,
  ecutwfc = 40.0 !40
  ecutrho = 400.0 !400
  nosym = .true.
  noinv = .true.
  ! force_symmorphic = .true.,   ! Force symmorphic symmetry to avoid z-component issues
  ! nosym = .false.  
  ! noinv = .false.  
  ! lspinorb = .true.        ! Enable spin-orbit coupling
  ! noncolin = .true.,
/


&ELECTRONS
  ! mixing_beta = 0.7,
  conv_thr = 1.0d-8
/

ATOMIC_SPECIES
  C  12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF

! ATOMIC_SPECIES
!   C  12.011  C.rel-pbe-n-rrkjus_psl.0.1.UPF

CELL_PARAMETERS {angstrom}
  2.1304  1.23  0.0
  2.1304 -1.23  0.0
  0.0   0.0   10.0
  
ATOMIC_POSITIONS {crystal}
  C 1/3 1/3 0.0
  C 2/3 2/3 0.0

! K_POINTS automatic
!   3 3 1   0 0 0


K_POINTS {crystal_b}
4225
